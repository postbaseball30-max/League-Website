<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>OPS League Website</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#0f172a}header{background:#fff;border-bottom:1px solid #e2e8f0;padding:18px 24px;position:sticky;top:0;z-index:10}.header-inner{max-width:1280px;margin:auto;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.brand-small{font-size:12px;color:#1d4ed8;font-weight:900;letter-spacing:2px;text-transform:uppercase}.brand-title{font-size:26px;font-weight:900}nav{display:flex;flex-wrap:wrap;gap:8px}button,input,select{font-family:inherit}.nav-btn,.pill-btn,.back-btn{border:0;border-radius:12px;padding:10px 14px;font-weight:800;cursor:pointer}.nav-btn{background:#f1f5f9;color:#334155}.nav-btn.active,.pill-btn.active{background:#1d4ed8;color:#fff}main{max-width:1280px;margin:auto;padding:28px 24px}.page-kicker{display:flex;gap:8px;color:#475569;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.6px}h1{font-size:34px;margin:10px 0 4px}h2{margin:0 0 12px}.subtitle{color:#64748b;margin-bottom:24px}.card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px;box-shadow:0 1px 3px rgba(15,23,42,.06);margin-bottom:20px}.grid{display:grid;gap:20px}.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}@media(max-width:800px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}}.table-wrap{overflow-x:auto;border:1px solid #e2e8f0;border-radius:16px;background:#fff;margin-bottom:18px}table{width:100%;border-collapse:collapse;background:#fff}th{background:#f1f5f9;color:#334155;text-align:left;padding:12px;font-size:13px;white-space:nowrap}td{border-top:1px solid #f1f5f9;padding:10px 12px;font-size:14px;white-space:nowrap}.link-btn{border:0;background:transparent;padding:0;color:#1d4ed8;font-weight:800;cursor:pointer;text-decoration:underline}.controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}input,select{border:1px solid #cbd5e1;border-radius:12px;padding:10px 12px;background:#fff;font-weight:700}.stat-box{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:18px}.stat-label{color:#64748b;font-size:13px}.stat-value{font-size:32px;font-weight:900}.back-btn{background:#fff;border:1px solid #cbd5e1;color:#334155;margin-bottom:16px}.muted{color:#64748b}.loading{padding:24px;text-align:center;color:#64748b}.card-img{width:100%;max-width:950px;display:block;margin:auto;border:2px solid #0f172a;border-radius:12px}.download-btn{display:block;text-align:center;padding:14px;border-radius:14px;background:#1d4ed8;color:white;text-decoration:none;font-weight:900;margin-top:14px}
</style>
</head>
<body>
<header><div class="header-inner"><div><div class="brand-small">The Bowler's Eye</div><div class="brand-title">OPS League Website</div></div><nav id="nav"></nav></div></header>
<main id="app"><div class="loading">Loading league data...</div></main>
<script>
const SHEET_ID="1Qcm1vlnWojOYEA6s8_tZ1y0IxnFbePE4j8Cy1zkWKeQ";
const T={standings:"Full Standings",schedule:"Current Schedule",fullSeason:"Full Season",league:"League",leaders:"Leaders",batters:"Batters",pitchers:"Pitcher",fielders:"Fielders",teams:"Teams",batSplits:"Batting Splits",pitSplits:"Pitcher Splits",records:"single game records",postseason:"Postseason"};
const TEAM_TABS=["CWY","LBS","OVR","OWL","PIT","Pit","RHN","SML","TK","TOR","UCH"];
let db={},state={page:"Standings",player:null,team:null,manager:null,stats:"Hitters",pos:"ALL",search:"",records:"Game / Season Records",career:"Hitters",schedule:"Current Week",showRecent:true};
const tabs=["Standings","Schedule","Free Agents","Leaderboards / Stats","Teams","Managers","Records","Postseason"];

function url(tab){return `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(tab)}`}
function csv(t){let rows=[],r=[],c="",q=false;for(let i=0;i<t.length;i++){let x=t[i],n=t[i+1];if(x=='"'&&q&&n=='"'){c+='"';i++}else if(x=='"')q=!q;else if(x==","&&!q){r.push(c);c=""}else if((x=="\n"||x=="\r")&&!q){if(x=="\r"&&n=="\n")i++;r.push(c);rows.push(r);r=[];c=""}else c+=x}if(c.length||r.length){r.push(c);rows.push(r)}return rows.map(a=>a.map(v=>(v||"").trim()))}
async function get(tab){try{let r=await fetch(url(tab));return csv(await r.text())}catch(e){console.warn(tab,e);return[]}}
function hrow(rows,need){return rows.findIndex(r=>need.every(n=>r.includes(n)))}
function objs(rows,i){let h=rows[i]||[];return rows.slice(i+1).filter(r=>r.some(Boolean)).map(r=>{let o={};h.forEach((x,j)=>{if(x)o[x]=r[j]||""});return o})}
function clean(v){if(!v)return"";let s=String(v).trim(),m=s.match(/\[([^\]]+)\]/);if(m)return m[1];return s.replace(/\(https?:\/\/[^)]+\)/g,"").replace(/https?:\/\/\S+/g,"").replace(/\[|\]/g,"").trim()}
function cleanTeam(v){if(!v)return"";let s=String(v).trim();if(/^https?:\/\//i.test(s))return"";return clean(s)}
function num(v){let n=parseFloat(String(v||"").replace(/[$,%]/g,""));return isFinite(n)?n:0}
function b(txt,act,cls="link-btn"){return `<button class="${cls}" onclick="${act}">${txt||""}</button>`}
function table(cols,rows){if(!rows||!rows.length)return`<div class="card muted">No data found.</div>`;return`<div class="table-wrap"><table><thead><tr>${cols.map(c=>`<th>${c.l}</th>`).join("")}</tr></thead><tbody>${rows.map((r,i)=>`<tr>${cols.map(c=>`<td>${c.r?c.r(r,i):(r[c.k]??"")}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`}
function head(t,s,i=""){return`<div class="page-kicker">${i} League Hub</div><h1>${t}</h1><div class="subtitle">${s}</div>`}

function normalize(){
 let rs=db.raw[T.standings]||[],hi=hrow(rs,["TM","Team","W","L"]);
 db.standings=hi>=0?objs(rs,hi).filter(r=>r.TM&&r.Team).map((r,i)=>({rank:i+1,tm:r.TM,team:r.Team,w:r.W,l:r.L,pct:r["%"],rd:r.RD,gb:r.GB||r.gb,streak:r.Streak,rs:r.RS,ra:r.RA,diff:r["Run Diff"],pythag:r.Pythag,home:r.Home,away:r.Away,last8:r["Last 8"]})):[];
 let br=db.raw[T.batters]||[],bh=hrow(br,["name","TM","PA","AB"]);
 db.batters=bh>=0?objs(br,bh).map(r=>({name:clean(r.name||r.Player),tm:r.TM,pos:"BAT",PA:r.PA,AB:r.AB,H:r.H,RBI:r.RBI,HR:r.HR,BB:r.BB,K:r.K,AVG:r.AVG,OBP:r.OBP,SLG:r.SLG,OPS:r.OPS,R:r.R,SB:r.SB,CS:r.CS})).filter(r=>r.name):[];
 let pr=db.raw[T.pitchers]||[],ph=hrow(pr,["name","TM","Role","W"]);
 db.pitchers=ph>=0?objs(pr,ph).map(r=>({name:clean(r.name||r.Player),tm:r.TM,pos:r.Role||"P",W:r.W,L:r.L,SV:r.SV,HD:r.HD,BS:r.BS,IP:r.IP,ERA:r.ERA,WHIP:r.WHIP,HR:r.HR,BB:r.BB,K:r.K,R:r.R,ER:r.ER})).filter(r=>r.name):[];
 db.players=[...db.batters,...db.pitchers].reduce((a,p)=>{if(!a.find(x=>x.name===p.name))a.push(p);return a},[]);
 db.league=parseLeague(db.raw[T.league]||[]);
 db.leaders=parseLeaders(db.raw[T.leaders]||[]);
 db.rosters={};TEAM_TABS.forEach(t=>{db.rosters[String(t).toUpperCase()]=parseRoster(db.raw[t]||[],String(t).toUpperCase())});
 db.batSplits=parseSplits(db.raw[T.batSplits]||[]);db.pitSplits=parseSplits(db.raw[T.pitSplits]||[]);
 db.schedule=parseGeneric(db.raw[T.schedule]||[]);db.fullSeason=parseGeneric(db.raw[T.fullSeason]||[]);
 db.records=parseGeneric(db.raw[T.records]||[]);db.postseason=parseGeneric(db.raw[T.postseason]||[]);
}
function parseLeague(rows){let o={free:[],inj:[],draft:[],dates:[]};for(let i=2;i<rows.length;i++){let r=rows[i];if(r[0]&&r[1])o.dates.push({Date:r[0],Description:r[1]});if(r[4])o.free.push({name:clean(r[4]),salary:r[7]||r[5],pos:r[6]});if(r[9])o.inj.push({name:clean(r[11]||r[9]),tm:r[10],effective:r[12],length:r[13],through:r[14],format:r[15]});if(r[17]||r[21])o.draft.push({round:r[17],pick:r[18],tm:r[19],player:clean(r[21]||r[22]),format:r[23]})}return o}
function parseLeaders(rows){
 let L={Hitters:{},Pitchers:{},Fielders:{}};
 for(let i=2;i<rows.length;i++){let r=rows[i];
  if(r[0]&&r[4]){let c=r[0];(L.Hitters[c]??=[]).push({player:clean(r[4]),team:cleanTeam(r[3]),value:r[5]||r[6]})}
  if(r[8]&&r[12]){let c=r[8];(L.Pitchers[c]??=[]).push({player:clean(r[12]),team:cleanTeam(r[11]),value:r[13]||r[14]})}
  if(r[16]&&r[20]){let c=r[16];(L.Fielders[c]??=[]).push({player:clean(r[20]),team:cleanTeam(r[19]),value:r[21]||r[22]})}
 }
 return L;
}
function parseRoster(rows,tm){let hi=hrow(rows,["Name","Format","Team","Player"]);if(hi<0)return[];return objs(rows,hi).map(r=>({name:clean(r.Player||r.Name),tm:r.Team||tm,status:r.Format,pos:r.Positions||r.Position,salary:r.Salary,PA:r.PA,AB:r.AB,H:r.H,RBI:r.RBI,HR:r.HR,OPS:r.OPS})).filter(r=>r.name&&r.name!=="Name")}
function parseSplits(rows){let hi=hrow(rows,["name","TM","Split"]);if(hi<0)return[];return objs(rows,hi).map(r=>({name:clean(r.name||r.Player),tm:r.TM,split:r.Split,role:r.Role,PA:r.PA,AB:r.AB,H:r.H,RBI:r.RBI,HR:r.HR,BB:r.BB,K:r.K,AVG:r.AVG,OBP:r.OBP,SLG:r.SLG,OPS:r.OPS,BF:r.BF,WHIP:r.WHIP,ERA:r.ERA})).filter(r=>r.name)}
function parseGeneric(rows){let i=rows.findIndex(r=>r.some(Boolean));if(i<0)return[];let h=rows[i].filter(Boolean).length>1?i:Math.min(i+1,rows.length-1);return objs(rows,h).filter(r=>Object.values(r).some(Boolean)).slice(0,100)}

function findP(n){return db.players.find(p=>p.name===n)||db.league.free.find(p=>p.name===n)||Object.values(db.rosters).flat().find(p=>p.name===n)||{name:n,tm:"FA"}}
function findT(tm){return db.standings.find(t=>String(t.tm).toUpperCase()===String(tm).toUpperCase())||{tm,team:tm,w:"",l:"",pct:"",gb:"",streak:""}}
const managers=[{name:"Mike Castagnaro",tm:"SML",w:312,l:198,pct:".612"},{name:"Anthony Russo",tm:"PIT",w:287,l:223,pct:".563"}];
function setPage(p){state.page=p;state.player=null;state.team=null;state.manager=null;render()}
function openPlayer(n){state.player=findP(n);state.team=null;state.manager=null;render()}
function openTeam(t){state.team=findT(t);state.player=null;state.manager=null;render()}
function openManager(n){state.manager=managers.find(m=>m.name===n)||managers[0];render()}
function nav(){document.getElementById("nav").innerHTML=tabs.map(t=>`<button class="nav-btn ${state.page===t&&!state.player&&!state.team&&!state.manager?"active":""}" onclick="setPage('${t}')">${t}</button>`).join("")}

function playerPage(p){let pit=db.pitchers.find(x=>x.name===p.name),bat=db.batters.find(x=>x.name===p.name),isP=!!pit&&!bat,stat=pit||bat||p,splits=(isP?db.pitSplits:db.batSplits).filter(x=>x.name===p.name);
 let statCols=isP?[["W","W"],["L","L"],["IP","IP"],["ERA","ERA"],["WHIP","WHIP"],["K","K"],["BB","BB"],["HR","HR"]]:[["PA","PA"],["AB","AB"],["H","H"],["HR","HR"],["RBI","RBI"],["BB","BB"],["K","K"],["AVG","AVG"],["OBP","OBP"],["SLG","SLG"],["OPS","OPS"]];
 return `${b("← Back","setPage('Free Agents')","back-btn")}<div class="card"><h1>${p.name}</h1><p class="muted">${stat.pos||""} • Team ${stat.tm?b(stat.tm,`openTeam('${stat.tm}')`):"FA"}</p><h2>Season Stats</h2>${table(statCols.map(x=>({k:x[0],l:x[1]})),[stat])}</div><div class="card"><h2>Splits</h2>${table(Object.keys(splits[0]||{}).map(k=>({k,l:k})),splits)}</div>`}
function teamPage(t){let r=db.rosters[String(t.tm).toUpperCase()]||[];return `${b("← Back","setPage('Standings')","back-btn")}<div class="card"><h1>${t.team}</h1><p>${t.tm} • ${t.w}-${t.l} • ${t.pct}</p></div><div class="grid grid-4"><div class="stat-box"><div class="stat-label">Wins</div><div class="stat-value">${t.w||"-"}</div></div><div class="stat-box"><div class="stat-label">Losses</div><div class="stat-value">${t.l||"-"}</div></div><div class="stat-box"><div class="stat-label">GB</div><div class="stat-value">${t.gb||"-"}</div></div><div class="stat-box"><div class="stat-label">Streak</div><div class="stat-value">${t.streak||"-"}</div></div></div><h2>Roster</h2>${table([{k:"name",l:"Player",r:r=>b(r.name,`openPlayer('${r.name.replace(/'/g,"\\'")}')`)},{k:"status",l:"Status"},{k:"pos",l:"Pos"},{k:"salary",l:"Salary"},{k:"PA",l:"PA"},{k:"HR",l:"HR"},{k:"OPS",l:"OPS"}],r)}`}
function renderPage(){
 if(state.player)return playerPage(state.player); if(state.team)return teamPage(state.team); if(state.manager)return `<div class="card"><h1>${state.manager.name}</h1><p>${state.manager.tm} • ${state.manager.w}-${state.manager.l} • ${state.manager.pct}</p></div>`;
 if(state.page==="Standings")return head("Standings","Live standings from Full Standings tab.","🏆")+table([{k:"rank",l:"Rank"},{k:"tm",l:"TM",r:r=>b(r.tm,`openTeam('${r.tm}')`)},{k:"team",l:"Team"},{k:"w",l:"W"},{k:"l",l:"L"},{k:"pct",l:"%"},{k:"rd",l:"RD"},{k:"gb",l:"GB"},{k:"streak",l:"Streak"},{k:"rs",l:"RS"},{k:"ra",l:"RA"},{k:"home",l:"Home"},{k:"away",l:"Away"},{k:"last8",l:"Last 8"}],db.standings);
 if(state.page==="Teams")return head("Teams","Click a team to view roster and stats.","⚾")+table([{k:"tm",l:"TM",r:r=>b(r.tm,`openTeam('${r.tm}')`)},{k:"team",l:"Team"},{k:"w",l:"W"},{k:"l",l:"L"},{k:"pct",l:"%"},{k:"gb",l:"GB"}],db.standings);
 if(state.page==="Schedule"){let rows=state.schedule==="Current Week"?db.schedule:db.fullSeason;return head("Schedule","Current week or full season schedule.","📅")+`<div class="controls">${["Current Week","Full Season"].map(x=>b(x,`state.schedule='${x}';render()`,"pill-btn "+(state.schedule===x?"active":""))).join("")}</div>`+table(Object.keys(rows[0]||{}).map(k=>({k,l:k})),rows)}
 if(state.page==="Free Agents"){let rows=db.league.free.filter(p=>(!state.search||p.name.toLowerCase().includes(state.search.toLowerCase()))&&(state.pos==="ALL"||(p.pos||"").includes(state.pos)));return head("Free Agents","Free agents, injured list, and draft results from League tab.","➕")+`<div class="controls"><input placeholder="Search players..." value="${state.search}" oninput="state.search=this.value;render()"><select onchange="state.pos=this.value;render()">${["ALL","SP","RP","C","1B","2B","3B","SS","OF","LF","CF","RF","DH"].map(x=>`<option ${state.pos===x?"selected":""} value="${x}">${x}</option>`).join("")}</select></div><h2>Free Agents</h2>`+table([{k:"name",l:"Player",r:r=>b(r.name,`openPlayer('${r.name.replace(/'/g,"\\'")}')`)},{k:"pos",l:"Position"},{k:"salary",l:"Salary"}],rows)+`<h2>Injured List</h2>`+table([{k:"name",l:"Player",r:r=>b(r.name,`openPlayer('${r.name.replace(/'/g,"\\'")}')`)},{k:"tm",l:"TM",r:r=>b(r.tm,`openTeam('${r.tm}')`)},{k:"effective",l:"Effective"},{k:"length",l:"Length"},{k:"through",l:"Through"}],db.league.inj)+`<h2>Draft Results</h2>`+table([{k:"round",l:"Round"},{k:"pick",l:"Pick"},{k:"tm",l:"TM",r:r=>b(r.tm,`openTeam('${r.tm}')`)},{k:"player",l:"Player",r:r=>b(r.player,`openPlayer('${r.player.replace(/'/g,"\\'")}')`)},{k:"format",l:"Format"}],db.league.draft)}
 if(state.page==="Leaderboards / Stats"){let data=state.stats==="Hitters"?db.leaders.Hitters:state.stats==="Pitchers"?db.leaders.Pitchers:db.leaders.Fielders;return head("Leaderboards / Stats","Leaders from Leaders tab. Logo URL columns are ignored.","📊")+`<div class="controls">${["Hitters","Pitchers","Fielders"].map(x=>b(x,`state.stats='${x}';render()`,"pill-btn "+(state.stats===x?"active":""))).join("")}</div><div class="grid grid-2">${Object.entries(data).map(([cat,rows])=>`<div><h2>${cat}</h2>${table([{k:"player",l:"Player",r:r=>b(r.player,`openPlayer('${r.player.replace(/'/g,"\\'")}')`)},{k:"team",l:"Team",r:r=>r.team?b(r.team,`openTeam('${r.team}')`):""},{k:"value",l:"Stat"}],rows.slice(0,10))}</div>`).join("")}</div>`}
 if(state.page==="Managers")return head("Managers","Manager records.","🧢")+table([{k:"name",l:"Manager",r:r=>b(r.name,`openManager('${r.name}')`)},{k:"tm",l:"TM",r:r=>b(r.tm,`openTeam('${r.tm}')`)},{k:"w",l:"W"},{k:"l",l:"L"},{k:"pct",l:"PCT"}],managers);
 if(state.page==="Records"){let rows=state.records==="Game / Season Records"?db.records:(state.career==="Hitters"?db.batters:db.pitchers);return head("Records","Records and career leaders.","📘")+`<div class="controls">${["Game / Season Records","Career Leaders"].map(x=>b(x,`state.records='${x}';render()`,"pill-btn "+(state.records===x?"active":""))).join("")}${state.records==="Career Leaders"?["Hitters","Pitchers"].map(x=>b(x,`state.career='${x}';render()`,"pill-btn "+(state.career===x?"active":""))).join(""):""}</div>`+table(Object.keys(rows[0]||{}).slice(0,14).map(k=>({k,l:k})),rows.slice(0,50))}
 if(state.page==="Postseason")return head("Postseason","Postseason results.","🏆")+table(Object.keys(db.postseason[0]||{}).map(k=>({k,l:k})),db.postseason);
 return "";
}
function render(){nav();document.getElementById("app").innerHTML=renderPage()}
async function init(){nav();db.raw={};let tabs=[...Object.values(T),...TEAM_TABS];await Promise.all(tabs.map(async t=>db.raw[t]=await get(t)));normalize();render()}
init();
</script>
</body>
</html>
